# Yivu (.gitignore)

# Environment variables & API tokens
.env
*.env
!.env.example

# Keystores & sensitive credentials
*.jks
*.keystore
google-services.json

# Builds & Binaries
*.apk
dist/
build/
.dart_tool/

# Database temporary files
backend/*.db-wal
backend/*.db-shm
backend/uploads/

# IDE & Editor
.idea/
*.iml
.vscode/
local.properties

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db
